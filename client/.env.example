# Frontend Environment Variables (Vite requires VITE_ prefix)
# DO NOT put backend secret keys or database credentials here!
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=
# Optional custom ICE / TURN servers JSON string (defaults to Google public STUN)
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
